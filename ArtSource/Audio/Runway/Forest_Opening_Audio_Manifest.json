    {
      "id": "L02",
      "speaker": "Jack",
      "text": "If you feel guilty, I'll happily take your cut.",
      "assetName": "VO_Jack_L02",
      "runwayTaskId": "f7069302-b36b-4c6d-8bb5-2767ddcb7526",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L03",
      "speaker": "Tyler",
      "text": "Not a chance. One night's work, a month's pay. What could go wrong?",
      "assetName": "VO_Tyler_L03",
      "runwayTaskId": "6be067cb-2801-4d61-ada3-6864c2291926",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L04",
      "speaker": "Ethan",
      "text": "Doesn't it bother you they never said what we're hunting?",
      "assetName": "VO_Ethan_L04",
      "runwayTaskId": "e28316ff-27d0-48e7-927a-d541b481ec34",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L05",
      "speaker": "Jack",
      "text": "Wildlife. That's what the contract said.",
      "assetName": "VO_Jack_L05",
      "runwayTaskId": "4403588d-0c3e-45ff-bb33-27ffda651986",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L06",
      "speaker": "Ethan",
      "text": "It also said no phones. You're all fine with that?",
      "assetName": "VO_Ethan_L06",
      "runwayTaskId": "37d6b370-4663-436a-ac39-94500169e752",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L07",
      "speaker": "Tyler",
      "text": "They paid half up front. For that money, I'd leave my pants at home.",
      "assetName": "VO_Tyler_L07",
      "runwayTaskId": "71379eb6-6bfe-4bbe-8fd9-aaa5b34d81b4",
      "expectedExtension": ".mp3"
    },
    {
      "id": "L08",
      "speaker": "Jack",
      "text": "Look at that gate... Since when do you need a fence like that for boars?",
